// 📊 ORB + Breakout 20d
// Timeframe: 1 hora (1H)  ← IMPORTANTE: usar gráfico de 1 hora
// Activo recomendado: SPY (ORB bien definido, breakouts limpios)
// Backtest: +22.8% anual, 58% win rate, PF 2.19
// Lógica: precio supera el máximo de la primera hora Y el máximo de 20 días,
//         con volumen y EMA20 a favor
//@version=5
strategy("📊 ORB + Breakout 20d", overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=30,
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=2)

// ── Parámetros ──────────────────────────────────────────────────────────────
orb_lb     = input.int(140,   "20d Lookback (140 barras 1h)", group="Estrategia")
ema_period = input.int(20,    "EMA período",                  group="Estrategia")
vol_mult   = input.float(1.5, "Vol mínimo (× media)",         group="Estrategia")
stop_pct   = input.float(7.0, "Stop Loss (%)",                group="Salidas") / 100
hard_tgt   = input.float(20.0,"Target (%)",                   group="Salidas") / 100
trail_trig = input.float(10.0,"Trail Trigger (%)",            group="Salidas") / 100
trail_pct  = input.float(5.0, "Trail desde pico (%)",         group="Salidas") / 100
time_stop  = input.int(84,    "Time Stop (barras ≈ 12d)",     group="Salidas")

// ── Indicadores ─────────────────────────────────────────────────────────────
is_new_day = ta.change(time("D")) != 0

// ORB High = high de la primera barra del día (9:30 ET)
orb_high   = ta.valuewhen(is_new_day, high, 0)

// Máximo de 20 días en barras 1h (sin look-ahead)
roll_high  = ta.highest(high[1], orb_lb)

ema20      = ta.ema(close, ema_period)
vol_ma     = ta.sma(volume, 20)

// ── Condiciones de entrada ───────────────────────────────────────────────────
above_orb   = close > orb_high
above_roll  = close > roll_high
vol_ok      = volume > vol_ma * vol_mult
above_ema20 = close > ema20

long_signal = above_orb and above_roll and vol_ok and above_ema20 and not is_new_day

// ── Control de una señal por día ─────────────────────────────────────────────
var bool traded_today = false
if is_new_day
    traded_today := false

// ── Gestión de posición ──────────────────────────────────────────────────────
var float peak_price = na
var int   entry_bar  = na
var bool  trail_on   = false

if long_signal and strategy.position_size == 0 and not traded_today
    strategy.entry("Long", strategy.long)
    entry_bar     := bar_index
    peak_price    := close
    trail_on      := false
    traded_today  := true

if strategy.position_size > 0
    peak_price := math.max(peak_price, close)
    pnl        = (close - strategy.position_avg_price) / strategy.position_avg_price
    from_peak  = (close - peak_price) / peak_price
    bars_held  = bar_index - entry_bar

    if pnl >= trail_trig
        trail_on := true

    if pnl <= -stop_pct
        strategy.close("Long", comment="Stop -7%")
    else if pnl >= hard_tgt
        strategy.close("Long", comment="Target +20%")
    else if trail_on and from_peak <= -trail_pct
        strategy.close("Long", comment="Trail stop")
    else if bars_held >= time_stop
        strategy.close("Long", comment="Time stop")

// ── Plots ────────────────────────────────────────────────────────────────────
plot(ema20,    "EMA20",    color=color.orange, linewidth=1)
plot(orb_high, "ORB High", color=color.new(color.yellow, 30), style=plot.style_stepline)
plot(roll_high,"20d High", color=color.new(color.purple, 50), linewidth=1)
plotshape(long_signal and strategy.position_size == 0 and not traded_today,
          "ORB Break", shape.labelup, location.belowbar,
          color.new(color.green, 0), size=size.normal)
bgcolor(above_roll and not is_new_day ? color.new(color.green, 94) : na,
        title="Sobre máximo 20d")
